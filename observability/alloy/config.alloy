discovery.docker "diddifreeid" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "diddifreeid" {
  targets = discovery.docker.diddifreeid.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_diddifree_observability"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "diddifreeid" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.diddifreeid.output
  forward_to = [loki.write.diddifreeid.receiver]
}

loki.write "diddifreeid" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
