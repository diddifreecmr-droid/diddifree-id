# Copy to `.env` for local development. Never commit `.env`.

ENVIRONMENT=development
API_PREFIX=/identity/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$

# Host-side values (docker-compose overrides these with service names).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15438/diddi_free_id
REDIS_URL=redis://localhost:16391/0
DB_HOST_PORT=15438
REDIS_HOST_PORT=16391
APP_HOST_PORT=18010

# --- DiddiObserve / Observability v1 -------------------------------------
# Required for the protected `/metrics` endpoint. The legacy
# METRICS_AUTH_TOKEN remains accepted for old deployments.
METRICS_BEARER_TOKEN=
OTEL_SERVICE_NAME=diddifree-id
SERVICE_VERSION=0.1.0
# Optional stable pod/container identifier. Docker HOSTNAME is used when empty.
SERVICE_INSTANCE_ID=
# DEPLOYMENT_ID is preferred; DIDDI_DEPLOYMENT_ID remains accepted.
DEPLOYMENT_ID=diddifree-id-development
# Leave disabled until DiddiObserve supplies the OTLP endpoint and, if used,
# its authentication header. A collector outage must never block the API.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Usually empty: the central HTTPS endpoint uses the system trust store. Set
# only a mounted CA path for an explicitly approved private CA.
OTEL_EXPORTER_OTLP_CERTIFICATE=
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_TRACE_SAMPLE_RATIO=0.1
OBSERVABILITY_LOG_FILE=/var/log/diddifree/observability-api.jsonl
WORKER_OBSERVABILITY_LOG_FILE=/var/log/diddifree/observability-worker.jsonl
OBSERVABILITY_LOG_MAX_BYTES=10485760
OBSERVABILITY_LOG_BACKUP_COUNT=5
OBSERVABILITY_LOG_VOLUME_NAME=diddifree-id-observability-logs-development
WORKER_HEARTBEAT_STALE_SECONDS=7200
WORKER_HEARTBEAT_TTL_SECONDS=14400

# --- RS256 signing keys ---------------------------------------------------
# Generate a dev pair with:  python scripts/generate_keys.py
# In production these paths point at files mounted from the secrets vault;
# the private key never lives in the repository or in a container image.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACTIVE_KID=dev-2026-07-01
# Previous key, still accepted while old tokens circulate during a rotation.
# Leave both empty when no rotation is in flight.
JWT_PREVIOUS_PUBLIC_KEY_PATH=
JWT_PREVIOUS_KID=

JWT_ISSUER=diddifree-id
JWT_ACCESS_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30
SERVICE_TOKEN_LIFETIME_SECONDS=600
ACCOUNT_DELETION_GRACE_DAYS=30

# --- OTP ------------------------------------------------------------------
OTP_CODE_LIFETIME_SECONDS=300
OTP_RATE_LIMIT_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Pepper mixed into the OTP hash so a database dump alone does not let an
# attacker reverse a 6-digit code by brute force. Rotate it and in-flight
# codes simply stop verifying — acceptable for a 5-minute lifetime.
OTP_HASH_PEPPER=change-me-in-prod-32-characters-minimum
# Staging-only diagnostic exception. When true, logs include OTP code and
# recipient. Set false before connecting any central collector or production.
OTP_LOG_PLAINTEXT=false
# Google Play Review accounts only. Keep disabled outside a controlled review
# environment. The JSON value belongs in Portainer, never in Git.
REVIEW_STATIC_OTP_ENABLED=false
REVIEW_STATIC_OTP_CODES_JSON=
REVIEW_STATIC_OTP_MAX_ATTEMPTS=5
REVIEW_STATIC_OTP_LOCK_SECONDS=900
OTP_PROVIDER=logging
OTP_SMS_PROVIDER=logging
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_API_TIMEOUT_SECONDS=20
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=direction.technique@diddifree.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@diddifree.com
SMTP_FROM_NAME=DiddiFreeID
SMTP_USE_TLS=true
# Telegram bot commented out in core/lifespan.py (2026-11-18).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_POLL_TIMEOUT_SECONDS=25
YELLIKA_SMS_BASE_URL=https://panel.yellikasms.com
YELLIKA_SMS_TOKEN=
YELLIKA_SMS_SENDER_ID=
YELLIKA_SMS_TIMEOUT_SECONDS=20
SENNDO_SMS_BASE_URL=https://api.senndo.com
SENNDO_SMS_API_KEY=
SENNDO_SMS_TIMEOUT_SECONDS=30

# --- Service-to-service ---------------------------------------------------
# Provisional mechanism for `GET /users/{user_id}` — see contract API §5.
# Comma-separated keys; empty disables key-based service auth, leaving only
# access tokens carrying `role=service`.
SERVICE_API_KEYS=
