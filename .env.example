# Copy to `.env` for local development. Never commit `.env`.

ENVIRONMENT=development
API_PREFIX=/identity/v1

# Host-side values (docker-compose overrides these with service names).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/diddi_free_id
REDIS_URL=redis://localhost:6381/0

# --- RS256 signing keys ---------------------------------------------------
# Generate a dev pair with:  python scripts/generate_keys.py
# In production these paths point at files mounted from the secrets vault;
# the private key never lives in the repository or in a container image.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACTIVE_KID=dev-2026-07-01
# Previous key, still accepted while old tokens circulate during a rotation.
# Leave both empty when no rotation is in flight.
JWT_PREVIOUS_PUBLIC_KEY_PATH=
JWT_PREVIOUS_KID=

JWT_ISSUER=diddifree-id
JWT_ACCESS_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# --- OTP ------------------------------------------------------------------
OTP_CODE_LIFETIME_SECONDS=300
OTP_RATE_LIMIT_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Pepper mixed into the OTP hash so a database dump alone does not let an
# attacker reverse a 6-digit code by brute force. Rotate it and in-flight
# codes simply stop verifying — acceptable for a 5-minute lifetime.
OTP_HASH_PEPPER=change-me-in-prod-32-characters-minimum
# In development the OTP is logged instead of sent by SMS. Never enable in prod.
OTP_LOG_PLAINTEXT=true

# --- Service-to-service ---------------------------------------------------
# Provisional mechanism for `GET /users/{user_id}` — see contract API §5.
# Comma-separated keys; empty disables key-based service auth, leaving only
# access tokens carrying `role=service`.
SERVICE_API_KEYS=
